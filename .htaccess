# copius.fr on OVH Web Hosting (Apache). It does by hand what GitHub Pages did
# implicitly. Generated by the Copius OVH switch script (kairos/ovh-switch/copius):
# change it there and re-run, not here.

AddDefaultCharset utf-8
AddCharset utf-8 .css .js .json .svg .txt .xml
Options -Indexes
DirectoryIndex index.html

# The 404 page uses absolute paths, so it renders at any depth.
ErrorDocument 404 /404.html

# Pages published only what Jekyll kept (see _config.yml): tools, docs, the plans,
# and every name starting with "." or "_". Apache serves the whole checkout, the
# .git folder included, so the same set answers 404. These two lines hold even
# without mod_rewrite; the rewrite rules below cover the same names at any depth.
RedirectMatch 404 "^/(\.git|\.github|\.claude|tools|docs)(/.*)?$"
RedirectMatch 404 "^/([._][^/]*|PLAN-[^/]*\.md|ROADMAP\.md|CNAME)$"

# The full version's data sits in js/ beside the six files the public atlas loads
# (Copius locked it on 25 Sept 2026; _config.yml keeps it off Pages by path). Here
# every other name in js/ answers 404, so a data file added later stays private
# until it is listed here and in PUBLISHED_JS in the repo's tools/validate.js.
RedirectMatch 404 "(?i)^/js/(?!(app|i18n|photos|page|free|data-techniques)\.js$)"

<IfModule mod_headers.c>
  # Pages served every file with a ten-minute cache, and the ?v= stamps on the
  # assets are built around that. The service worker must never wait on a cache.
  # /api/ sets its own: this line would add a second Cache-Control to a script's
  # answer, and "always set" would replace it (tools/validate.js checks both).
  Header set Cache-Control "max-age=600" "expr=%{REQUEST_URI} !~ m#^/api/#"
  <Files "service-worker.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hidden names answer 404 first, before any redirect could confirm they exist.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)[._] - [R=404,L]
  RewriteRule ^(tools|docs)(/.*)?$ - [R=404,L]
  RewriteRule ^(PLAN-[^/]*\.md|ROADMAP\.md|CNAME)$ - [R=404,L]
  RewriteRule ^js/(?!(app|i18n|photos|page|free|data-techniques)\.js$) - [NC,R=404,L]
  # One hop to https://copius.fr, as Pages did: www to the bare domain, http to
  # https (OVH's documented SERVER_PORT method), and a folder's missing trailing
  # slash. REDIRECT_STATUS keeps the 404 page itself from being redirected when a
  # missing URL came in over http: it must answer 404, not 301.
  RewriteCond %{HTTP_HOST} ^www\.copius\.fr$ [NC]
  RewriteRule ^(.*)$ https://copius.fr/$1 [R=301,L]
  RewriteCond %{SERVER_PORT} ^80$
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^(.*)$ https://copius.fr/$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://copius.fr/$1/ [R=301,L]
  # A folder with no index.html is a 404 on Pages; here it would be a 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>
